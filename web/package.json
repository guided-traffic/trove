{
  "name": "trove-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "extract-i18n": "ng extract-i18n --format xlf2 --output-path src/locale --out-file messages.xlf",
    "lint": "eslint . && node scripts/check-rules.mjs",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "generate:api": "openapi-typescript ../api/openapi.yaml --output src/app/api/generated/schema.d.ts",
    "build:embed": "node scripts/build-embed.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/aria": "22.2.5",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "material-icons": "1.13.14",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
