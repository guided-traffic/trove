# --- end-to-end load (deploy/dev/e2e.sh, test/e2e) ---------------------------------
# k6 runs as a container on the kind Docker network, so no host install is needed and CI and
# laptops run the same binary. The tag must be K6_VERSION without the "v" (e2e.sh checks it).
K6_IMAGE=docker.io/grafana/k6:2.3.0@sha256:2dd4756ec6e14e62778916e1eb850108e4b499304c02df56760fa0bdb0fba0b8

# --- npm client matrix and reference lockfile (test/e2e/clients, perf/npm, R-NPM-045) ---------------
# The one Node image of the npm tests. Its tag is web/.nvmrc on the glibc slim variant (make versions-check
# compares them; perf/npm/reference.sh refuses a tag whose version differs). Every gate row accepts this Node
# (engines of the clients in test/e2e/clients/package-lock.json: npm 12 ^22.22.2 || ^24.15.0 || >=26.0.0;
# pnpm 11 >=22.13). The clients themselves are pinned in test/e2e/clients/package.json and package-lock.json,
# one exact version per row; the npm that writes perf/npm/reference/package-lock.json is the one bundled in
# this image, so the lockfile has one writer version.
E2E_CLIENTS_NODE_IMAGE=docker.io/library/node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39
E2E_CLIENTS_CURL_VERSION=8.14.1-2+deb13u7
E2E_CLIENTS_JQ_VERSION=1.7.1-6+deb13u4

# --- NuGet golden vectors (tools/nugetvectors, R-NUGET-003) ----------------------------------------
# The .NET SDK image that builds tools/nugetvectors and the NuGet.Versioning it links: the reference implementation the
# version, range and ID rules of internal/formats/nuget are tested against. `make nuget-vectors` regenerates
# internal/formats/nuget/version/testdata/vectors.json with them and `make nuget-vectors-check` compares. A new pin
# changes the vectors, so the update and the regenerated file travel in one pull request.
NUGETVECTORS_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
# renovate: datasource=nuget depName=NuGet.Versioning
NUGET_VERSIONING_VERSION=7.9.0

# --- NuGet clients image (test/e2e/nugetclients, R-NUGET-027) ---------------------------------------
# The .NET SDK of the dotnet client rows is the SDK image of the golden vectors: one .NET SDK in the repository
# (make versions-check compares the two lines; renovate.json groups both in one pull request, ".NET SDK (NuGet tests)"). nuget.exe runs on
# the Mono of that image's Ubuntu: the apt version of the packages is pinned exactly, so a superseded package fails
# the build. nuget.exe is fetched from dist.nuget.org by version and verified against its SHA-256; a new version
# and its digest are one edit.
E2E_NUGETCLIENTS_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
# The .NET 8 and .NET 9 SDKs of the audit scenarios of R-VULN-018 (restore reports NU1903 and NU1904 with .NET 8, 9 and 10): the
# image copies the SDK and its runtime from these images next to the .NET 10 SDK, and a project picks one with a global.json
# (docs/developer/e2e.md#the-vulnerability-tests). Each is the newest patch of its major at the time of the pin.
E2E_NUGETCLIENTS_SDK8_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0.427@sha256:6ba9644da07bb5b560a402acec9ca38711a0762969f1b61da261df5c9f6f85da
E2E_NUGETCLIENTS_SDK9_IMAGE=mcr.microsoft.com/dotnet/sdk:9.0.320@sha256:7e3a4bd66701a451823db2028154ae16ff191bc452596ba618ef4d0c58f9cd01
E2E_NUGETCLIENTS_MONO_VERSION=6.8.0.105+dfsg-3.6ubuntu2
E2E_NUGETCLIENTS_NUGET_EXE_VERSION=7.9.0
E2E_NUGETCLIENTS_NUGET_EXE_SHA256=992d70cac5b06c38efec91806caba64cdcc07e6d963a0959dbbbaf264d33b800
# The reference pipeline of R-CI-028 runs in these client images and its exchange step needs `curl` and `jq` (the pipeline installs
# them with apt-get when a job image lacks them, which a non-root pod with a read-only root file system cannot do). The npm clients
# image gets both from Debian trixie, the NuGet clients image (Ubuntu, curl already installed) gets jq. Exact apt versions, so that a
# superseded package fails the build instead of changing the client.
E2E_NUGETCLIENTS_JQ_VERSION=1.7.1-3ubuntu0.24.04.2

# --- OCI clients (test/e2e/ociclients, R-OCI-035, Q-OCI-21) ---------------------------------------------------------
# The two clients of the OCI e2e set, both pinned by digest: the Docker Engine with the CLI and Buildx (the dind variant of the
# official image runs dockerd in the client pod) and Podman. Renovate moves tag and digest together (the *_IMAGE rule of
# renovate.json); `make versions-check` (test/e2e/ociclients/check-pins.mjs) compares the tags with what the Dockerfile and
# the pod manifest use, and the tests compare `docker version` and `podman --version` with the tags.
E2E_OCICLIENTS_DOCKER_IMAGE=docker.io/library/docker:29.9.3-dind@sha256:08a98015fce594af7c382883bea080ea206de74402a95da9dc52b6428c8cd121
E2E_OCICLIENTS_PODMAN_IMAGE=quay.io/podman/stable:v5.8.9@sha256:f7a17ef911a2b9b866ada8a9426a07e29a6e4f8109ef8c0e0b7010c2541b4e49

# --- APT clients (test/e2e/aptclients, R-DEB-035, Q-DEB-27) ---------------------------------------------------------
# The four clients of the Debian e2e set, each pinned by the digest of the multi-architecture index of its official image, so that
# the arm64 host and the amd64 runner run the same release: Debian 13 (APT 3.0, signatures checked by sqv), Debian 12 (APT 2.6),
# Ubuntu 24.04 (APT 2.7) and Ubuntu 22.04 (APT 2.4); the last three verify with gpgv. The tag is the release the client stands
# for and never moves (renovate.json takes the digest only); `make versions-check` (test/e2e/aptclients/check-pins.mjs) compares
# the four tags with the names the tests use, and TestAPTClients compares /etc/os-release and `apt --version` with them.
E2E_APTCLIENTS_DEBIAN13_IMAGE=docker.io/library/debian:13@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
E2E_APTCLIENTS_DEBIAN12_IMAGE=docker.io/library/debian:12@sha256:268fb24c39bca92d326dd83ea3abebe4a3f7751c804ffef23bb6d857dd343ff8
E2E_APTCLIENTS_UBUNTU2404_IMAGE=docker.io/library/ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
E2E_APTCLIENTS_UBUNTU2204_IMAGE=docker.io/library/ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
