# reachable on https://localhost:8080 (TROVE_DEV_HTTP_PORT). The image is the chart's own default tag
# (chart 0.16.3 ships v0.16.3) pinned by digest. The owner moved the pin from 0.15.3 to 0.16.3 on 2026-10-30.
# renovate: datasource=helm registryUrl=https://haproxy-ingress.github.io/charts depName=haproxy-ingress
DEV_HAPROXY_INGRESS_CHART_VERSION=0.16.3
# The archive is a GitHub release asset (n42-gateway/charts): checked against this digest, which the chart index lists for it, by
# deploy/dev/lib.sh chart_release_tgz (as CNPG_CHART_SHA256; a Renovate bump of the version needs this digest too).
DEV_HAPROXY_INGRESS_CHART_SHA256=f9829363e7c685f9207a660b9a4358365d94679515e3ac24217ad5f6d7aef00c
