# The one pin file for every tool and image that is not a Go module (E0.2).
# KEY=value lines only: no quotes, no spaces around "=", no variable references.
# The Makefile reads it with `include`; CI appends it to $GITHUB_ENV (.github/actions/load-pins).
# Go itself is pinned by the `go` line of go.mod; sqlc and oapi-codegen by the `tool` directives of
# go.mod; Angular by web/package-lock.json; Node by web/.nvmrc; the release tooling by package-lock.json.
#
# A `# renovate:` comment directly above a pin lets Renovate update it (renovate.json, custom regex
# managers). The image lines carry their digest; Renovate updates tag and digest together.

# --- local and CI tools -------------------------------------------------------
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2/cmd/golangci-lint
GOLANGCI_LINT_VERSION=v2.15.0
# renovate: datasource=go depName=golang.org/x/vuln/cmd/govulncheck
GOVULNCHECK_VERSION=v1.9.0
# renovate: datasource=go depName=github.com/fzipp/gocyclo/cmd/gocyclo
GOCYCLO_VERSION=v0.6.0
# Workflow linter of .github/workflows (CI job `workflows`, and locally: go install at this pin).
# renovate: datasource=go depName=github.com/rhysd/actionlint/cmd/actionlint
ACTIONLINT_VERSION=v1.7.12
# OpenAPI breaking-change checker of the compat job (R-ARCH-025; `make compat-check`, test/compat). Installed as a
# binary at this pin, not as a go.mod requirement, so the product module's graph does not carry its dependencies.
# renovate: datasource=go depName=github.com/oasdiff/oasdiff
OASDIFF_VERSION=v1.35.0
# osv-scanner is the oracle of the matcher's real-record corpus (R-VULN-009): `make osv-expected` runs its offline mode over the
# frozen records and freezes the results in internal/vuln/match/testdata; the tests need neither the tool nor the network.
# renovate: datasource=go depName=github.com/google/osv-scanner/v2
OSV_SCANNER_VERSION=v2.7.0
# renovate: datasource=go depName=sigs.k8s.io/kind
KIND_VERSION=v0.33.0
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.2
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
# The latest Helm 3, which R-HA-049 supports until its security support ends on 2027-02-10: only the platform matrix of
# deploy/dev/k8s-matrix.sh (job k8s-matrix of the nightly) installs it, beside HELM_VERSION in a leg of its own.
# renovate: datasource=github-releases depName=helm/helm
HELM3_VERSION=v3.22.1
# renovate: datasource=github-releases depName=grafana/k6
K6_VERSION=v2.3.0
# promtool (the rule tests of the charts, test/chart, R-HA-045, R-BAS-041) is the release binary of Prometheus at this
# pin. `go install` of the module is refused (its go.mod carries replace directives), so `make promtool` downloads the
# release archive and checks it against the SHA-256 of its platform below (from the release's sha256sums.txt). A new
# version and its four digests are one edit, which is why no Renovate comment is above the pin.
PROMTOOL_VERSION=v3.15.1
PROMTOOL_SHA256_DARWIN_AMD64=c89fcb30045d8c394c9d93e96cbbee3aaf2448a48326b417e811eb4e528edf88
PROMTOOL_SHA256_DARWIN_ARM64=0d4d3d9837d27e4fcd0bd16d115b1b8d6732a4bf3e69107f1190d9ef653ae471
PROMTOOL_SHA256_LINUX_AMD64=6a726885328ad9efebbf36e876ce2fb6225468a71fd1e7ce3ba666d5f4d97a84
PROMTOOL_SHA256_LINUX_ARM64=ceb6d21493c37ca0b4513b147642797c68cf39a0f50a444d50e1e80c74f21b26
# renovate: datasource=helm registryUrl=https://cloudnative-pg.github.io/charts depName=cloudnative-pg
CNPG_CHART_VERSION=0.29.1
# The archive of the chart is a GitHub release asset (the chart index points there): deploy/dev/lib.sh chart_release_tgz fetches it
# with tools/github-download.sh and checks it against this digest. The digest is the one the chart index lists for 0.29.1 and the
# one GitHub reports for the asset. The cloudnative-pg release also has the helm provenance file (.prov), which is not verified: no publisher key
# is pinned (H-589). A Renovate bump of the version needs this digest too, and fails the chart install until it follows (Q-ARCH-356).
CNPG_CHART_SHA256=b53d3991fe84bcf38767e7702cae78666265427a127a26fff168ab4207d2b1df
# Silo, the maintained fork of the MinIO server, for the S3 conformance leg (make silo-up).
SILO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-11-09T00-00-00Z@sha256:08ce1505b5eacefbad1ca07159b242b9ce045a11c2817e3bc257b25f77bbc02d

# --- release image (Containerfile, build.yml) and the security scans --------------
# Distroless static base of the release image, pinned by digest (Containerfile build-arg RUNTIME_BASE_IMAGE).
RUNTIME_BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
# Docker Buildx: the plugin of every workflow job (.github/actions/install-buildx, Q-ARCH-355) and `make versions-check` locally.
# The two digests are the release's checksums.txt for the two Linux platforms of the runners. No Renovate comment: as for
# Trivy and promtool, a new version and its digests are one edit by hand. A version-only Renovate pull request would fail
# the install step on every runner without the new plugin, by design, so it is not opened.
BUILDX_VERSION=v0.38.1
BUILDX_SHA256_LINUX_AMD64=e25d5cd675092bb5d1d03632fdc46cdf3fede7b514dc5f023a105e00d3ce5ad4
BUILDX_SHA256_LINUX_ARM64=3b83b3731916ba433feccaaa689fe5bcdc81c641d92c8e6c2ea865dfa141c97a
# Syft writes both SBOMs of the release image (build.yml): the SPDX file of the release (the image SYFT_IMAGE, run by the build job
# on the registry tag, Q-HA-204) and the SBOM attestation in the image index (the generator image of tools/sbom-generator, built from
# SYFT_IMAGE, Q-HA-166). SYFT_VERSION is the one version; SYFT_IMAGE is the same version by digest, and `make versions-check` fails
# when its tag differs. Neither file downloads syft from GitHub.
# renovate: datasource=github-releases depName=anchore/syft
SYFT_VERSION=v1.55.0
SYFT_IMAGE=docker.io/anchore/syft:v1.55.0@sha256:4cc92b64ca74ffca4c94d4c8fcc01f217731375300be14d0b6eeb2e82eaa110a
# The shell of the SBOM generator (tools/sbom-generator): its static busybox, pinned by digest.
SBOM_GENERATOR_SHELL_IMAGE=docker.io/library/busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478
# The throwaway registry that serves the generator to the builder (tools/sbom-generator/registry.sh), on a docker network of its own.
SBOM_GENERATOR_REGISTRY_IMAGE=docker.io/library/registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
# Trivy scans the built image in the container scan job. `make trivy` downloads the release archive and checks it
# against the SHA-256 of its platform below (from the release's checksums.txt), so the job does not depend on
# aquasecurity/setup-trivy's cache and download. A new version and its four digests are one edit, which is why no
# Renovate comment is above the pin.
TRIVY_VERSION=v0.76.2
TRIVY_SHA256_DARWIN_AMD64=e08bb9ea449ecf66c6bfb03cbb8697c503ff33d35fc585c9747e3eaeb7ed4c7b
TRIVY_SHA256_DARWIN_ARM64=ae7ea358326960406b703c77b2ac490190797d80b306b5b50c2a27221da0a5b8
TRIVY_SHA256_LINUX_AMD64=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf
TRIVY_SHA256_LINUX_ARM64=ab9d51f86e6a5fb936f605faff6b593ac51bc378fff4d3e8b9d58358b9c367c3

