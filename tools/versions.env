# The one pin file for every tool and image that is not a Go module (E0.2).
# KEY=value lines only: no quotes, no spaces around "=", no variable references.
# The Makefile reads it with `include`; CI appends it to $GITHUB_ENV (.github/actions/load-pins).
# Go itself is pinned by the `go` line of go.mod; sqlc and oapi-codegen by the `tool` directives of
# go.mod; Angular by web/package-lock.json; Node by web/.nvmrc; the release tooling by package-lock.json.
#
# A `# renovate:` comment directly above a pin lets Renovate update it (renovate.json, custom regex
# managers). The image lines carry their digest; Renovate updates tag and digest together.

# --- local and CI tools -------------------------------------------------------
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2/cmd/golangci-lint
GOLANGCI_LINT_VERSION=v2.15.0
# renovate: datasource=go depName=golang.org/x/vuln/cmd/govulncheck
GOVULNCHECK_VERSION=v1.9.0
# renovate: datasource=go depName=github.com/fzipp/gocyclo/cmd/gocyclo
GOCYCLO_VERSION=v0.6.0
# Workflow linter of .github/workflows (CI job `workflows`, and locally: go install at this pin).
# renovate: datasource=go depName=github.com/rhysd/actionlint/cmd/actionlint
ACTIONLINT_VERSION=v1.7.12
# renovate: datasource=go depName=sigs.k8s.io/kind
KIND_VERSION=v0.33.0
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.36.2
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v3.21.3
# renovate: datasource=github-releases depName=grafana/k6
K6_VERSION=v2.3.0
# renovate: datasource=helm registryUrl=https://cloudnative-pg.github.io/charts depName=cloudnative-pg
CNPG_CHART_VERSION=0.29.1
# MinIO is built from source at this commit for the S3 conformance leg (Q-HA-3, make minio-up).
MINIO_COMMIT=7aac2a2c5b7c882e68c1ce017d8256be2feea27f

# --- release image (Containerfile, build.yml) and the security scans --------------
# Distroless static base of the release image, pinned by digest (Containerfile build-arg RUNTIME_BASE_IMAGE).
RUNTIME_BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
# Docker Buildx: docker/setup-buildx-action `version` in every workflow, and `make versions-check` locally.
# renovate: datasource=github-releases depName=docker/buildx
BUILDX_VERSION=v0.38.1
# Syft writes the SPDX SBOM of the release image (anchore/sbom-action `syft-version` in build.yml).
# renovate: datasource=github-releases depName=anchore/syft
SYFT_VERSION=v1.55.0
# Trivy scans the built image in the container scan job (aquasecurity/trivy-action `version`).
# renovate: datasource=github-releases depName=aquasecurity/trivy
TRIVY_VERSION=v0.70.0

# --- integration stack (test/integration/compose.yaml) -------------------------
# PostgreSQL 16 is the floor version (Q-HA-2).
INTEGRATION_POSTGRES_IMAGE=docker.io/library/postgres:16.15@sha256:1beaa3084eee2676f20a9cd9928f0bf2c5bf674f8e49f81017912183d377c61c
INTEGRATION_PGBOUNCER_IMAGE=docker.io/edoburu/pgbouncer:v1.26.1-p0@sha256:488422e38cff912895d0d65d8963fcd306e6ac589a724398b6eb8e294e94d624
# Newest patch of each supported Valkey line; the compose stack selects one with
# Valkey 9.1 only (owner, 2026-10-29: no older line is guaranteed during development).
VALKEY_91_IMAGE=docker.io/valkey/valkey:9.1.3-alpine3.24@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
# Throwaway standalone server of an unsupported line: test/integration/valkey checks that trove refuses it (R-ARCH-031).
INTEGRATION_VALKEY_81_IMAGE=docker.io/valkey/valkey:8.1.11-alpine@sha256:2602ace2be6569bc2bbb06f873776516ab9089821525be34f4305c67eb9db02a
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8
# One-shot helper container that creates buckets and exercises the S3 API.
INTEGRATION_TOOLS_IMAGE=docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# --- dev profile (deploy/dev) ---------------------------------------------------
# The Helm agent extends this section; keep every image pinned by digest.
DEV_KIND_NODE_IMAGE=docker.io/kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
DEV_CNPG_POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:16.15-standard-trixie@sha256:1ec419e997a8bde5263b6951f4c5ebc4aa2e1937927001f2561025c0a816e174
DEV_VALKEY_IMAGE=docker.io/valkey/valkey:9.1.3-alpine3.24@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
DEV_SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8
# The one openssl: every script that makes certificates runs it from this image (entrypoint
# openssl), so no host openssl (LibreSSL, 3.x) is involved. deploy/dev/valkey-certs.sh,
# test/integration/certs.sh.
OPENSSL_IMAGE=docker.io/alpine/openssl:3.5.9@sha256:1c361a204e9791bec6202bccbd1065eafaa65cb5a1a9a06ae000238569fba6a2
# The test IdP of the dev profile (deploy/dev/keycloak.yaml, Q-AUTH-35): the multi-arch index, so it runs on arm64 nodes too.
DEV_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:a78d6b79572168cb25886b80a8b5b8d4ed4390743e3eecb810538683e209dd6b
# The operator image of the CloudNativePG chart (CNPG_CHART_VERSION above); pinned by digest.
DEV_CNPG_OPERATOR_IMAGE=ghcr.io/cloudnative-pg/cloudnative-pg:1.30.1@sha256:923c267ec29636db3bee20f993d0ec4973fa22998e1adad37da79e4d32b5bc07
# Creates the dev buckets in SeaweedFS (deploy/dev/s3.yaml).
DEV_AWSCLI_IMAGE=docker.io/amazon/aws-cli:2.39.1@sha256:3517c17b5f01637df3b6184a4280fbcc36e4ea38105954cade628ff17bb9a7b9
# The edge of the dev cluster: HAProxy Ingress (the owner's production controller and chart pin),
# reachable on https://localhost:8080 (TROVE_DEV_HTTP_PORT). The image is the chart's own default tag
# (chart 0.15.3 ships v0.15.3) pinned by digest.
# renovate: datasource=helm registryUrl=https://haproxy-ingress.github.io/charts depName=haproxy-ingress
DEV_HAPROXY_INGRESS_CHART_VERSION=0.15.3
DEV_HAPROXY_INGRESS_IMAGE=quay.io/jcmoraisjr/haproxy-ingress:v0.15.3@sha256:e22c83d96912fd84c2c4ffaaf2c827c1b92a65b5ed7edd5bc4b0285d5a71820a
# cert-manager issues every certificate of the dev cluster from one self-signed root (Issuer trove-dev-ca).
# The chart pin follows the owner's `v1.*` track at the newest release; the four images are the chart's own
# (appVersion = chart version) pinned by digest. trust-manager is not installed: nothing in the profile
# distributes a trust bundle, every consumer reads the ca.crt that cert-manager puts into its Secret.
# renovate: datasource=helm registryUrl=https://charts.jetstack.io depName=cert-manager
DEV_CERT_MANAGER_CHART_VERSION=v1.21.3
DEV_CERT_MANAGER_CONTROLLER_IMAGE=quay.io/jetstack/cert-manager-controller:v1.21.3@sha256:9f4f96a33c7774cef24466fcd85031997531a03a8d117f151126baa8d1290dcc
DEV_CERT_MANAGER_WEBHOOK_IMAGE=quay.io/jetstack/cert-manager-webhook:v1.21.3@sha256:055ac8e9de6a0ba6763794838fe38944acc650f68ebe1b01dd8be079e580f458
DEV_CERT_MANAGER_CAINJECTOR_IMAGE=quay.io/jetstack/cert-manager-cainjector:v1.21.3@sha256:083d0e906f8eb44e255fe4ff817ae54e49f9ed82e22f1011bb4e9e4f4b8a641f
DEV_CERT_MANAGER_STARTUPAPICHECK_IMAGE=quay.io/jetstack/cert-manager-startupapicheck:v1.21.3@sha256:1c519d4afca1413d1e4ccd78bdc756184418ab55a34569a3b3de39d32f9974e1
# The Valkey operator (Valkey custom resource, Sentinel mode, TLS through cert-manager) and the secret generator.
# renovate: datasource=helm registryUrl=https://guided-traffic.github.io/valkey-operator/ depName=valkey-operator
DEV_VALKEY_OPERATOR_CHART_VERSION=1.14.12
DEV_VALKEY_OPERATOR_IMAGE=docker.io/guidedtraffic/valkey-operator:1.14.12@sha256:20fc2f9f762123a2f10c5fc6545ac18cebef197bf850bed9cede3d2c68ae649d
# These two operator images are published for linux/amd64 only, so the pins are the amd64 manifests (the
# multi-arch index would not resolve on an arm64 node). On an arm64 host the Docker VM needs qemu user-mode
# emulation for amd64: `docker run --privileged --rm $DEV_BINFMT_IMAGE --install amd64` (up.sh checks and says so).
DEV_BINFMT_IMAGE=docker.io/tonistiigi/binfmt:qemu-v10.0.4-56@sha256:30cc9a4d03765acac9be2ed0afc23af1ad018aed2c28ea4be8c2eb9afe03fbd1
# renovate: datasource=helm registryUrl=https://guided-traffic.github.io/internal-secrets-operator depName=internal-secrets-operator
DEV_ISO_CHART_VERSION=1.6.14
DEV_ISO_IMAGE=docker.io/guidedtraffic/internal-secrets-operator:1.6.14@sha256:f5bf41f5e838d1325d7f1496fe2c82ac3d84a675acbb56c2953fa73919f6f1ab

# --- end-to-end load (deploy/dev/e2e.sh, test/e2e) ---------------------------------
# k6 runs as a container on the kind Docker network, so no host install is needed and CI and
# laptops run the same binary. The tag must be K6_VERSION without the "v" (e2e.sh checks it).
K6_IMAGE=docker.io/grafana/k6:2.3.0@sha256:2dd4756ec6e14e62778916e1eb850108e4b499304c02df56760fa0bdb0fba0b8
