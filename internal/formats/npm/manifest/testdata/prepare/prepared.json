    "name": "gyp",
    "version": "1.0.0",
    "scripts": {
      "install": "node-gyp rebuild"
    }
  },
  "binding.gyp with preinstall": {
    "name": "gyp2",
    "version": "1.0.0",
    "scripts": {
      "preinstall": "echo"
    }
  },
