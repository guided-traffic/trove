    "name": "gh",
    "version": "1.0.0",
    "dependencies": {
      "a": "github:user/repo",
      "b": "github:user/repo",
      "c": "git+https://github.com/user/repo.git",
      "d": "git+ssh://git@github.com/user/repo.git#v1",
