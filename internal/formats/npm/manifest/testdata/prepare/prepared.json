{
  "plain": {
    "name": "plain",
    "version": "1.0.0",
    "dependencies": {
      "react": "^19.0.0"
    }
  },
  "string bin on a scoped name": {
    "name": "@acme/ui",
    "version": "1.0.0",
    "bin": {
      "ui": "cli.js"
    }
  },
  "array bin": {
    "name": "arr",
    "version": "1.0.0",
    "bin": {
      "a.js": "bin/a.js",
      "b.js": "bin/b.js"
    }
  },
  "object bin with odd keys and targets": {
    "name": "obj",
    "version": "1.0.0",
    "bin": {
      "other": "bin/y.js",
      "tool": "x.js"
    }
  },
  "directories.bin": {
    "name": "dirbin",
    "version": "1.0.0",
    "bin": {
      "sub": "tools/sub",
      "a": "tools/a",
      "b": "tools/sub/b"
    }
  },
  "bundledDependencies true": {
    "name": "bd",
    "version": "1.0.0",
    "dependencies": {
      "a": "1",
      "b": "2"
    },
    "bundleDependencies": [
      "a",
      "b"
    ]
  },
  "bundleDependencies object": {
    "name": "bd2",
    "version": "1.0.0",
    "dependencies": {
      "a": "1",
      "c": "*"
