{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trove-bastion chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "highAvailability": {
      "type": "object",
      "properties": {
        "enforce": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "behavior": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "AlwaysAllow",
            "IfHealthyBudget"
          ]
        }
      },
      "additionalProperties": false
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "nodeTaintsPolicy": {
          "type": "string",
          "enum": [
            "Honor",
            "Ignore"
          ]
        },
        "zone": {
          "type": "object",
          "properties": {
            "maxSkew": {
              "type": "integer",
              "minimum": 1
            },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": [
                "DoNotSchedule",
                "ScheduleAnyway"
              ]
            }
          },
          "additionalProperties": false
        },
        "host": {
          "type": "object",
          "properties": {
            "maxSkew": {
              "type": "integer",
              "minimum": 1
            },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": [
                "DoNotSchedule",
                "ScheduleAnyway"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "cacheVolume": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ephemeral",
            "persistent",
            "emptyDir"
          ]
        },
        "storageClassName": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        },
        "routeByPath": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "Rendered to /etc/trove/trove.yaml. Free-form until the generated schema of the role bastion is wired in here (docs/developer/helm-chart.md, Bastion chart); the keys the chart reads itself are typed below.",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "listen": {
              "type": "string"
            },
            "ops_listen": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "trusted_proxies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "bastion": {
          "type": "object",
          "properties": {
            "main": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              }
            },
            "cache": {
              "type": "object",
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "volume",
                    "bucket"
                  ]
                },
                "bucket": {
                  "type": "object",
                  "properties": {
                    "bucket": {
                      "type": "string"
                    },
                    "credentials": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "static",
                            "webIdentity",
                            "default"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "authenticated": {
                  "type": "object",
                  "properties": {
                    "requests_per_second": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "blocking": {
              "type": "object",
              "properties": {
                "exempt_cidrs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "valkey": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "sentinel",
                "standalone"
              ]
            },
            "sentinel": {
              "type": "object",
              "properties": {
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_name": {
                  "type": "string"
                },
                "tls": {
                  "type": "boolean"
                }
              }
            },
            "address": {
              "type": "string"
            }
          }
        },
        "tracing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "mainToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "signingKey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "cacheBucket": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "accessKeyIdKey": {
              "type": "string",
              "minLength": 1
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "valkey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "valkeyCA": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trustedCA": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "ClusterIssuer",
                    "Issuer"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "tmp": {
      "type": "object",
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "opsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "ipFamilyPolicy": {
          "type": "string",
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ]
        },
        "ipFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "IPv4",
              "IPv6"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "backendTLS": {
          "type": "object",
          "properties": {
            "verify": {
              "type": "boolean"
            },
            "caSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edgeLimit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requestsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "connections": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "https": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            },
            "ops": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            },
            "probeCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dns": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "main": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "valkey": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "cacheBucket": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "tracing": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "disabledAlerts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "initContainers": {
      "type": "array"
    },
    "sidecars": {
      "type": "array"
    },
    "extraObjects": {
      "type": "array"
    }
  }
}
