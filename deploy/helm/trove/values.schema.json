            },
            "regionKey": {
              "type": "string"
            },
            "endpointKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "valkey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "valkeySentinel": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "valkeyCA": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "valkeyClientCert": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "encryption": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.key$"
              }
            }
          },
          "additionalProperties": false
        },
        "metricsToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
