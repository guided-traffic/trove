{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trove chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "highAvailability": {
      "type": "object",
      "properties": {
        "enforce": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxSurge": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxUnavailable": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "spool": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Kubernetes quantity"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Kubernetes quantity"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Kubernetes quantity"
              }
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "minAvailable": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "unhealthyPodEvictionPolicy": {
              "type": "string",
              "enum": [
                "AlwaysAllow",
                "IfHealthyBudget"
              ]
            }
          },
          "additionalProperties": false
        },
        "topologySpread": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "nodeTaintsPolicy": {
              "type": "string",
              "enum": [
                "Honor",
                "Ignore"
              ]
            },
            "zone": {
              "type": "object",
              "properties": {
                "maxSkew": {
                  "type": "integer",
                  "minimum": 1
                },
                "whenUnsatisfiable": {
                  "type": "string",
                  "enum": [
                    "DoNotSchedule",
                    "ScheduleAnyway"
                  ]
                }
              },
              "additionalProperties": false
            },
            "host": {
              "type": "object",
              "properties": {
                "maxSkew": {
                  "type": "integer",
                  "minimum": 1
                },
                "whenUnsatisfiable": {
                  "type": "string",
                  "enum": [
                    "DoNotSchedule",
                    "ScheduleAnyway"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeFailureTolerationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "affinity": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "schedulerName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxSurge": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxUnavailable": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "spool": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Kubernetes quantity"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Kubernetes quantity"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Kubernetes quantity"
              }
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "minAvailable": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "unhealthyPodEvictionPolicy": {
              "type": "string",
              "enum": [
                "AlwaysAllow",
                "IfHealthyBudget"
              ]
            }
          },
          "additionalProperties": false
        },
        "topologySpread": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "nodeTaintsPolicy": {
              "type": "string",
              "enum": [
                "Honor",
                "Ignore"
              ]
            },
            "zone": {
              "type": "object",
              "properties": {
                "maxSkew": {
                  "type": "integer",
                  "minimum": 1
                },
                "whenUnsatisfiable": {
                  "type": "string",
                  "enum": [
                    "DoNotSchedule",
                    "ScheduleAnyway"
                  ]
                }
              },
              "additionalProperties": false
            },
            "host": {
              "type": "object",
              "properties": {
                "maxSkew": {
                  "type": "integer",
                  "minimum": 1
                },
                "whenUnsatisfiable": {
                  "type": "string",
                  "enum": [
                    "DoNotSchedule",
                    "ScheduleAnyway"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeFailureTolerationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "affinity": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "schedulerName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "Rendered to /etc/trove/trove.yaml. Free-form until the binary emits internal/config/schema.json; the chart-owned parts are typed below.",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "pattern": "^(https?://[^/?#]+)?$"
            },
            "trusted_proxies": {
              "type": "array"
            }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ssl_mode": {
              "type": "string",
              "enum": [
                "disable",
                "allow",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "session_host": {
              "type": "string"
            }
          }
        },
        "valkey": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "sentinel",
                "standalone"
              ]
            },
            "sentinel": {
              "type": "object",
              "properties": {
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_name": {
                  "type": "string"
                },
                "tls": {
                  "type": "boolean"
                }
              }
            },
            "address": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "verify-full",
                    "verify-ca",
                    "disable"
                  ]
                }
              }
            },
            "allow_insecure": {
              "type": "boolean"
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "s3": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "force_path_style": {
                  "type": "boolean"
                },
                "credentials": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "default",
                        "webIdentity",
                        "static"
                      ]
                    }
                  }
                }
              }
            },
            "upload": {
              "type": "object",
              "properties": {
                "max_size": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "description": "Kubernetes quantity"
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "string",
              "enum": [
                "none",
                "static"
              ]
            }
          }
        },
        "health": {
          "type": "object",
          "properties": {
            "shutdown_drain_delay": {
              "type": "string",
              "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
