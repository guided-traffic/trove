# The image of the counting OCI test upstream (test/ocistub/cmd/ocistub): a static binary on the release
# image's base, with the generated image set compiled in. It is not the release image and is never pushed;
# `make oci-stub-image` builds it and deploy/dev/e2e.sh loads it into kind.
# It serves TLS only: a certificate (or -self-signed) must be given at start.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG TARGETARCH
COPY ocistub-linux-${TARGETARCH} /ocistub
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/ocistub"]
