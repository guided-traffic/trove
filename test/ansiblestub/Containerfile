# The image of the counting Ansible Galaxy test upstream (test/ansiblestub/cmd/ansiblestub): a static binary on the release
# image's base, with the generated collections and roles compiled in. It is not the release image and is never pushed;
# `make ansible-stub-image` builds it and deploy/dev/e2e.sh loads it into kind.
# It serves TLS only: a certificate (or -self-signed) must be given at start.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG TARGETARCH
COPY ansiblestub-linux-${TARGETARCH} /ansiblestub
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/ansiblestub"]
