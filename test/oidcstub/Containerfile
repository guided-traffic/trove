# The image of the GitLab-shaped OIDC issuer double (test/oidcstub/cmd/oidcstub): a static binary on the
# release image's base. It is not the release image and is never pushed; `make oidc-stub-image` builds it
# and deploy/dev/e2e.sh loads it into kind. The issuer endpoints serve TLS only: a certificate (or
# -self-signed) must be given at start.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG TARGETARCH
COPY oidcstub-linux-${TARGETARCH} /oidcstub
USER 65532:65532
EXPOSE 8443 8444 8080
ENTRYPOINT ["/oidcstub"]
