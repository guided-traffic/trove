# The image of the test advisory source (test/osvstub/cmd/osvstub): a static binary on the release image's base,
# with the fixture and the frozen real records compiled in. It is not the release image and is never pushed;
# `make osv-stub-image` builds it and deploy/dev/e2e.sh loads it into kind.
# It serves TLS only: a certificate (or -self-signed) must be given at start.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG TARGETARCH
COPY osvstub-linux-${TARGETARCH} /osvstub
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/osvstub"]
